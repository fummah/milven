# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/mutingwende

# JWT
JWT_SECRET=your-secret

# Web app base URL (for email links)
WEB_BASE_URL=http://localhost:5173

# SMTP (e.g. for verification and password reset emails)
# Use port 465 for SSL/TLS
SMTP_HOST=smtp.zbsburial.com
SMTP_PORT=465
SMTP_USER=info@zbsburial.com
SMTP_PASS=your-password
SMTP_FROM=info@zbsburial.com

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Milven Slides
SLIDES_STORAGE_DIR=./storage/milven-slides
# Optional explicit renderer paths (auto-detected when omitted)
LIBREOFFICE_PATH=
PDFTOPPM_PATH=
SLIDES_CONCURRENCY=2
SLIDES_MAX_ATTEMPTS=3

SLIDES_PREVIEW_WIDTH=1920
SLIDES_THUMB_WIDTH=480
SLIDES_PREVIEW_FORMAT=png
SLIDE_ASSET_RATE_LIMIT_MAX=20000
SLIDES_STALL_TIMEOUT_MINUTES=60

# PDF summary sheets
SUMMARY_SHEET_STORAGE_DIR=./storage/summary-sheets
SUMMARY_PDF_MAX_BYTES=262144000
SUMMARY_SHEET_CONCURRENCY=2
SUMMARY_SHEET_MAX_ATTEMPTS=3
SUMMARY_SHEET_STALL_TIMEOUT_MINUTES=60

# PDF Formula Books
FORMULA_BOOK_STORAGE_DIR=./storage/formula-books
FORMULA_BOOK_PDF_MAX_BYTES=262144000
FORMULA_BOOK_CONCURRENCY=2
FORMULA_BOOK_MAX_ATTEMPTS=3
FORMULA_BOOK_STALL_TIMEOUT_MINUTES=60

# PDF Module Notes
MODULE_NOTE_PDF_STORAGE_DIR=./storage/module-note-pdfs
MODULE_NOTE_PDF_MAX_BYTES=262144000
MODULE_NOTE_PDF_CONCURRENCY=2
MODULE_NOTE_PDF_MAX_ATTEMPTS=3
MODULE_NOTE_PDF_STALL_TIMEOUT_MINUTES=60
